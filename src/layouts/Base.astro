---
import "../styles/global.css";
import { url } from "../lib/tips";

interface Props {
  title?: string;
  description?: string;
}

const siteName = "to - 言いあえる関係について";
const { title, description = "言いにくいことも、お互いに言える関係をつくるためのコツを、一枚ずつ図にして集めています。" } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem("to-cvd") === "1") document.documentElement.dataset.cvd = "true";
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a href={url("/")} class="logo" aria-label="to トップへ">
        <svg width="40" height="20" viewBox="0 0 40 20" aria-hidden="true">
          <path d="M8 8 Q20 -1 32 8" stroke="#26262B" stroke-width="1.4" fill="none" stroke-linecap="round"></path>
          <path d="M32 12 Q20 21 8 12" stroke="#26262B" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-dasharray="2 3"></path>
          <circle cx="6" cy="10" r="4.5" fill="#DD6B4D"></circle>
          <circle cx="34" cy="10" r="4.5" fill="#3F7CB0"></circle>
        </svg>
        <span>to</span>
      </a>
      <div class="header-tools">
        <button type="button" class="cvd-toggle" aria-pressed="false" data-cvd-toggle>
          <span class="cvd-knob"></span>色に頼らない表示
        </button>
        <a href="https://craftpaperbag.github.io/zu/" class="sister-link">姉妹サイト zu</a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <span>to - 言いあえる関係について</span>
      <span>図は試しながら、少しずつ増えていきます。</span>
    </footer>

    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>("[data-cvd-toggle]")!;
      const sync = () => btn.setAttribute("aria-pressed", root.dataset.cvd === "true" ? "true" : "false");
      sync();
      btn.addEventListener("click", () => {
        const on = root.dataset.cvd !== "true";
        if (on) root.dataset.cvd = "true";
        else delete root.dataset.cvd;
        try {
          localStorage.setItem("to-cvd", on ? "1" : "0");
        } catch (e) {}
        sync();
      });
    </script>
  </body>
</html>
